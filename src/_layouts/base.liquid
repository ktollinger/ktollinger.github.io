<!doctype html>
<html lang="{{ lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <link rel="stylesheet" href="{{ '/css/index.css' | url }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <title>{{ title | default: page.fileSlug }}</title>

    <!-- Anti-FOUC: set theme before render -->
    <script>
      (function() {
        var t = localStorage.getItem('cv-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
  <div class="root">
    <div class="main">
      <div class="controls-corner">
        <div class="toggle toggle--lang">
          {% if lang == 'cs' %}
          <span class="toggle__option toggle__option--active">CZ</span>
          <a href="{{ '/en/' | url }}" class="toggle__option">EN</a>
          {% elsif lang == 'en' %}
          <a href="{{ '/' | url }}" class="toggle__option">CZ</a>
          <span class="toggle__option toggle__option--active">EN</span>
          {% endif %}
        </div>

        <button class="toggle toggle--theme" id="theme-toggle" aria-label="Toggle theme">
          <span class="toggle__option" data-theme-option="light">☀️</span>
          <span class="toggle__option" data-theme-option="dark">🌙</span>
        </button>

        <button class="btn-print" id="print-btn" title="{% if lang == 'cs' %}Stáhnout PDF / Tisk{% else %}Download PDF / Print{% endif %}" aria-label="PDF">
          <i class="fa-solid fa-file-pdf fa-fw"></i>
        </button>
      </div>
      <div class="container">
        <div class="metadata">
          <div class="metadata__header">
            <h1>{{ title | default: page.fileSlug }}</h1>
          </div>
          <div class="subtitle">{{ description }}</div>
          <div class="infoline"><i class="fa-solid fa-phone fa-fw"></i> {{ phone }}</div>
          <div class="infoline"><i class="fa-solid fa-map-location-dot fa-fw"></i> {{ address }}</div>
          <div class="infoline"><i class="fa-regular fa-envelope fa-fw"></i> {{ email }}</div>
          <div class="infoline"><i class="fa-brands fa-linkedin fa-fw"></i> <a href="{{ linkedin }}">{{ linkedin }}</a> </div>
          <div class="infoline"><i class="fa-solid fa-globe fa-fw"></i> <a href="https://ktollinger.github.io/">ktollinger.github.io</a></div>
        </div>
        <div class="image-container">
            <img src="{{ '/img/kamil.jpg' | url }}" width="200" height="200" alt="Portrait Image">
        </div>
      </div>    
{{ content }}
    </div>
  </div>

  <dialog id="print-dialog" class="print-dialog">
    <form method="dialog">
      {% if lang == 'cs' %}
      <h3 style="margin-top: 0; margin-bottom: 0.5rem;">Životopis v PDF</h3>
      <p style="margin-bottom: 1.25rem;">Stáhněte si připravený PDF dokument nebo vytiskněte aktuální stránku:</p>

      <div style="margin-bottom: 1.5rem;">
        <a href="{{ '/pdf/Kamil_Tollinger_CV_CS.pdf' | url }}" download class="btn-download-pdf">
          <i class="fa-solid fa-file-arrow-down fa-fw"></i> Stáhnout kompletní PDF (Česky)
        </a>
      </div>

      <div style="font-size: 0.85rem; color: var(--main-fg-color-dim); margin-bottom: 0.75rem;">Vlastní tisk / export z prohlížeče:</div>
      <div class="print-dialog-buttons">
        <button value="cancel" class="btn-cancel">Zavřít</button>
        <div style="flex: 1"></div>
        <button value="full" class="btn-secondary">Plná verze</button>
        <button value="compact" class="btn-secondary">Kompaktní (1 strana)</button>
      </div>
      {% else %}
      <h3 style="margin-top: 0; margin-bottom: 0.5rem;">CV in PDF</h3>
      <p style="margin-bottom: 1.25rem;">Download the pre-generated PDF document or print the current page:</p>

      <div style="margin-bottom: 1.5rem;">
        <a href="{{ '/pdf/Kamil_Tollinger_CV_EN.pdf' | url }}" download class="btn-download-pdf">
          <i class="fa-solid fa-file-arrow-down fa-fw"></i> Download full PDF (English)
        </a>
      </div>

      <div style="font-size: 0.85rem; color: var(--main-fg-color-dim); margin-bottom: 0.75rem;">Custom browser print / export:</div>
      <div class="print-dialog-buttons">
        <button value="cancel" class="btn-cancel">Close</button>
        <div style="flex: 1"></div>
        <button value="full" class="btn-secondary">Full version</button>
        <button value="compact" class="btn-secondary">Compact (1 page)</button>
      </div>
      {% endif %}
    </form>
  </dialog>

  <script src="{{ '/js/theme.js' | url }}"></script>
  <script src="{{ '/js/print.js' | url }}"></script>
  </body>
</html>